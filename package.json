    "split",
    "code-splitting",
    "static-analysis",
    "refactoring",
    "modularity"
  ],
  "license": "MIT",
  "author": "unn-Known1 <ptelgm.yt@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/unn-Known1/splitcode.git"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "node-html-parser": "^9.0.4",
    "typescript": "^5.9.3"
  }
}
